VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Alias also accepted by vite.config (legacy name):
# VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
VITE_SUPABASE_PROJECT_ID=your-project-ref
VITE_APP_URL=http://localhost:8080
# Public production URL (canonical, Open Graph, sitemap)
VITE_SITE_URL=https://vetocrm.com

# Stripe (publishable OK in Vite; secret/webhook ONLY in Edge Function secrets)
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_xxx
# STRIPE_SECRET_KEY=sk_test_xxx
# STRIPE_WEBHOOK_SECRET=whsec_xxx
# APP_URL=https://vetocrm.com

# Demo login panel (local only). Never set VITE_ENABLE_DEMO in production.
# VITE_ENABLE_DEMO=true
# VITE_DEMO_PASSWORD=DemoVetpro2026!
# Seed demos via Edge Function only (ops/curl), never from the browser:
#   DEMO_SEED_ENABLED=true + DEMO_SEED_SECRET=<long random>
#   curl -X POST "$SUPABASE_URL/functions/v1/seed-demo-users" \
#     -H "x-demo-seed-secret: $DEMO_SEED_SECRET" -H "Content-Type: application/json" -d '{}'

# For database restore only (never commit real password):
# SUPABASE_DB_PASSWORD=your-database-password
