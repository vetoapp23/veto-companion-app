{
  "headers": [
    {
      "source": "/sitemap.xml",
      "headers": [
        { "key": "Content-Type", "value": "application/xml; charset=utf-8" },
        { "key": "Cache-Control", "value": "public, max-age=3600" }
      ]
    },
    {
      "source": "/robots.txt",
      "headers": [
        { "key": "Content-Type", "value": "text/plain; charset=utf-8" },
        { "key": "Cache-Control", "value": "public, max-age=3600" }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/((?!sitemap\\.xml$|robots\\.txt$|manifest\\.webmanifest$|og-cover\\.jpg$|favicon\\.ico$|favicon\\.svg$|apple-touch-icon\\.png$|favicon-32\\.png$|stock-template\\.csv$|assets/).*)",
      "destination": "/index.html"
    }
  ]
}
